# python3 run.py creates .env from this template and loads it automatically.
# Existing shell environment values take precedence. Restart after editing .env.
AWS_REGION=us-east-1
# Use a model or inference profile with Converse tool support available in YOUR account.
BEDROCK_MODEL_ID=
FIRMS_MAP_KEY=
# Leave empty for a local test inbox. Never use a public topic for sensitive content.
NTFY_TOPIC_URL=
NTFY_TOKEN=
OSRM_URL=https://router.project-osrm.org
PHAROS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# NWS api.weather.gov requires a User-Agent identifying the app (generic, no personal data).
NWS_USER_AGENT=PHAROS-wildfire-exercise (set to your contact)
# Optional free Census API key (https://api.census.gov/data/key_signup.html) for ACS demographics.
CENSUS_API_KEY=
# Optional free OpenRouteService key (https://openrouteservice.org/dev/#/signup) for evacuation
# rerouting with true avoid-polygons. Without it, routing falls back to keyless OSRM alternatives.
ORS_API_KEY=

# AI-camera detection ingest. Leave empty to serve the synthetic camera fixture.
# The feed must return JSON (a list, or an object with a "detections" array).
# Detections are provider-reported, not confirmed fire and not local inference.
CAMERA_FEED_URL=
CAMERA_FEED_TOKEN=

# MCP server transport. stdio (default) for local agents; http for remote agents.
# http is served at /mcp and requires PHAROS_MCP_TOKEN (sent as "Authorization: Bearer <token>").
PHAROS_MCP_TRANSPORT=stdio
PHAROS_MCP_HOST=127.0.0.1
PHAROS_MCP_PORT=8787
PHAROS_MCP_TOKEN=

# Photon Beta SMS. Use photon to send approved drafts, inbox for storage-only tests.
# ntfy remains available in the Python backend with PHAROS_DELIVERY_PROVIDER=ntfy.
PHAROS_DELIVERY_PROVIDER=inbox
PHOTON_PROJECT_ID=pho_prj_01m7dw21ypen99cbybaedeeajh
# Project-scoped API key (pho_sk_...), stored only as a hosting secret.
PHOTON_API_KEY=
# Sender User ID (pho_usr_...) and existing SMS Space ID (pho_spc_...).
PHOTON_SENDER_ID=
PHOTON_SPACE_ID=

# Gemini (Google AI Studio key: https://aistudio.google.com/apikey). Chooses each district's send
# languages and translates the exercise message. Without it, a share-based rule and fixed templates are used.
GEMINI_API_KEY=
# Optional model override. Default is a current Flash-Lite model.
GEMINI_MODEL=

# Twilio WhatsApp (sandbox) alternative to Photon. Set PHAROS_DELIVERY_PROVIDER=twilio_whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_TO=
# Twilio plain SMS instead of WhatsApp: PHAROS_DELIVERY_PROVIDER=twilio_sms, plus TWILIO_FROM (your Twilio number) and TWILIO_TO
TWILIO_FROM=

# Resend email delivery: PHAROS_DELIVERY_PROVIDER=resend_email
RESEND_API_KEY=
RESEND_TO=
# Optional; defaults to the Resend test sender (which can only email your own Resend account address)
RESEND_FROM=

# Photon hosted iMessage (no Mac needed): PHAROS_DELIVERY_PROVIDER=photon_imessage
# Uses PHOTON_API_KEY and PHOTON_PROJECT_ID plus the one fixed recipient below.
PHOTON_IMESSAGE_TO=
