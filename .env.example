# Export values in your shell; the app does not automatically load this file.
AWS_REGION=us-east-1
# Use a model or inference profile with Converse tool support available in YOUR account.
BEDROCK_MODEL_ID=
FIRMS_MAP_KEY=
# Leave empty for a local test inbox. Never use a public topic for sensitive content.
NTFY_TOPIC_URL=
NTFY_TOKEN=
OSRM_URL=https://router.project-osrm.org
PHAROS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# NWS api.weather.gov requires a User-Agent identifying the app (generic, no personal data).
NWS_USER_AGENT=PHAROS-wildfire-exercise (set to your contact)
# Optional free Census API key (https://api.census.gov/data/key_signup.html) for ACS demographics.
CENSUS_API_KEY=
# Optional free OpenRouteService key (https://openrouteservice.org/dev/#/signup) for evacuation
# rerouting with true avoid-polygons. Without it, routing falls back to keyless OSRM alternatives.
ORS_API_KEY=

# AI-camera detection ingest. Leave empty to serve the synthetic camera fixture.
# The feed must return JSON (a list, or an object with a "detections" array).
# Detections are provider-reported, not confirmed fire and not local inference.
CAMERA_FEED_URL=
CAMERA_FEED_TOKEN=

# MCP server transport. stdio (default) for local agents; http for remote agents.
# http is served at /mcp and requires PHAROS_MCP_TOKEN (sent as "Authorization: Bearer <token>").
PHAROS_MCP_TRANSPORT=stdio
PHAROS_MCP_HOST=127.0.0.1
PHAROS_MCP_PORT=8787
PHAROS_MCP_TOKEN=
